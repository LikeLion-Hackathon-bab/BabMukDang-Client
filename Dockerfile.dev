# --- Development Dockerfile ---
FROM node:20-alpine
WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci

# Copy source
COPY . .

# Expose Vite dev server port and HMR websocket
EXPOSE 5173 24678

# Use host networking-style binding for Vite HMR across Docker
ENV VITE_HOST=0.0.0.0

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]


